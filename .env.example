# Optional: enables "Generate my week with AI" on the Setup screen.
# These are read server-side only (by the /api proxy), never exposed to the browser bundle.
# Tried in order: OpenAI, then xAI (Grok), then Groq, then Gemini, falling back on any failure.
# OpenAI: https://platform.openai.com/api-keys (pay-as-you-go, no free tier)
OPENAI_API_KEY=
# xAI (Grok): https://console.x.ai (pay-as-you-go)
XAI_API_KEY=
# Groq: https://console.groq.com/keys (generous free tier, fast inference)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey (free tier, but some
# Google Workspace/org projects have it disabled — see README)
GEMINI_API_KEY=

# Optional: enables live store pricing and barcode lookup on the shopping list.
# Register an app at https://developer.kroger.com to get a client id/secret
# (the "Product Compact" scope is sufficient). Read server-side only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# For a real deployment (e.g. Vercel), set these same variables in the hosting
# platform's project settings — don't rely on a committed .env file in production.
